# ===== 影视下载台 media 栈配置 =====
# 部署前复制为 .env：  cp .env.example .env

# 页面访问端口（影视下载台 Web UI）
AUTOPILOT_PORT=8787

# 可选：页面访问令牌（留空 = 不鉴权）
AUTOPILOT_TOKEN=

# ===== 境外外网访问（唯一通常需要改的出口配置）=====
# 留空 = 直连出网（无需代理）；仅当宿主机无法直连外网时才填。
# 形如： http://host:port   或   http://user:pass@host:port
# 大多数代理客户端（Clash / v2ray / SS）都会开一个 HTTP 端口，用那个即可。
# 页面上填一个完整 URL 即可，下面三项是它解析后的结果（一般无需手动改）。
UPSTREAM_PROXY_HOST=
UPSTREAM_PROXY_PORT=
UPSTREAM_PROXY_AUTH=

# ===== 下载器 / *arr 凭据（按需修改）=====
# 统一账号，与 Radarr/Sonarr/Prowlarr/QBittorrent 的 WebUI 管理员一致。
# 改这里会同时影响 autopilot 探测 qB 用的密码，需与 compose 里 qB 的 WEBUI_PASSWORD 保持一致。
QBITTORRENT_USER=admin
QBITTORRENT_PASS=MediaFn2026

# ===== 媒体库设置（发现墙 / 搜索 / 一键下载，可选）=====
# 在页面「出网配置 → 媒体库设置」里填也行。留空则发现墙不可用。
# Radarr / Sonarr：在各自 WebUI 的 Settings → General 里拿 API Key
RADARR_URL=http://media-radarr:7878
RADARR_API_KEY=
SONARR_URL=http://media-sonarr:8989
SONARR_API_KEY=
# TMDB：https://www.themoviedb.org/settings/api 申请，发现墙筛选/海报依赖它
TMDB_API_KEY=
