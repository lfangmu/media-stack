# ===== 影视下载台 media 栈配置 =====
# 部署前复制为 .env：  cp .env.example .env

# 页面访问端口（影视下载台 Web UI）
AUTOPILOT_PORT=8787

# 可选：页面访问令牌（留空 = 不鉴权）
AUTOPILOT_TOKEN=

# ===== 境外外网访问（唯一通常需要改的出口配置）=====
# 留空 = 仅内网（不出外网）。
# 形如： http://host:port   或   http://user:pass@host:port
# 大多数代理客户端（Clash / v2ray / SS）都会开一个 HTTP 端口，用那个即可。
# 页面上填一个完整 URL 即可，下面三项是它解析后的结果（一般无需手动改）。
UPSTREAM_PROXY_HOST=
UPSTREAM_PROXY_PORT=
UPSTREAM_PROXY_AUTH=

# ===== 下载器 / *arr 凭据（按需修改）=====
QBITTORRENT_USER=admin
QBITTORRENT_PASS=adminadmin
