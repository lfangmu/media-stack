# ===== 影视下载台 media 栈配置 =====
# 部署前复制为 .env：  cp .env.example .env

# 页面访问端口（影视下载台 Web UI）
AUTOPILOT_PORT=8787

# 可选：页面访问令牌（留空 = 不鉴权）
AUTOPILOT_TOKEN=

# ===== 容器运行身份 / 权限（重要）=====
# Radarr / Sonarr / Prowlarr / QBittorrent 是 linuxserver 镜像，以 PUID/PGID 指定的用户写库。
# 必须等于「持有本项目目录的宿主用户」的 uid/gid，否则会出现
#   attempt to write a readonly database（添加影片等写操作 500）
# 运行 `id -u` / `id -g` 查看；推荐直接用 ./deploy.sh 部署（自动填入并统一 chown，无需手改）。
PUID=1000
PGID=1000

# ===== 境外外网访问（唯一通常需要改的出口配置）=====
# 留空 = 直连出网（无需代理）；仅当宿主机无法直连外网时才填。
# 形如： http://host:port   或   http://user:pass@host:port
# 大多数代理客户端（Clash / v2ray / SS）都会开一个 HTTP 端口，用那个即可。
# 这个 EGRESS_PROXY 是 autopilot 实际读取的键；下面 UPSTREAM_PROXY_* 是它解析后的结果（一般无需手动改）。
EGRESS_PROXY=
UPSTREAM_PROXY_HOST=
UPSTREAM_PROXY_PORT=
UPSTREAM_PROXY_AUTH=

# ===== 抓取完成通知（可选）=====
# 留空=关闭；填写后 autopilot 抓到资源并完成入库时推送通知（飞书/企业微信/Discord 机器人等 Webhook）。
AUTOPILOT_WEBHOOK_URL=

# ===== 下载目录（两层，可选；页面「配置」里也能改）=====
# ① qB 实际下载/做种目录：须落在 ./data 挂载内（见 compose 的 ./data:/data），否则 qB→*arr 硬链接失效。
QB_SAVE_PATH=/data/downloads
# ② 电影库 / 剧集库默认根目录：*arr 导入后的落盘位置，也是页面搜索时每次添加的默认选中项。
MOVIE_ROOT=/data/movies
TV_ROOT=/data/tv

# ===== 下载器 / *arr 凭据（按需修改）=====
# 统一账号，与 Radarr/Sonarr/Prowlarr/QBittorrent 的 WebUI 管理员一致。
# 改这里会同时影响 autopilot 探测 qB 用的密码，需与 compose 里 qB 的 WEBUI_PASSWORD 保持一致。
QBITTORRENT_USER=admin
QBITTORRENT_PASS=MediaFn2026

# ===== 媒体库设置（发现墙 / 搜索 / 一键下载，可选）=====
# 在页面「出网配置 → 媒体库设置」里填也行。留空则发现墙不可用。
# Radarr / Sonarr：在各自 WebUI 的 Settings → General 里拿 API Key
RADARR_URL=http://media-radarr:7878
RADARR_API_KEY=
SONARR_URL=http://media-sonarr:8989
SONARR_API_KEY=
# TMDB：https://www.themoviedb.org/settings/api 申请，发现墙筛选/海报依赖它
TMDB_API_KEY=
